#: src/common/config.py:138
msgid "Notifications"
msgstr "Notificaciones"

#: src/common/config.py:139
msgid "Desktop notifications appear on the computer running Themerr. Docker and headless installations do not display them."
msgstr "Las notificaciones de escritorio aparecen en el equipo que ejecuta Themerr. Las instalaciones Docker e sin cabeceras no las muestran."

#: src/common/config.py:144 src/common/notifications.py:138
msgid "New release available"
msgstr "Nueva versión disponible"

#: src/common/config.py:145
msgid "Notify when a newer Themerr release is available. Checks run once per hour."
msgstr "Notificar cuando esté disponible una nueva versión de Themerr. Las comprobaciones se ejecutan una vez por hora."

#: src/common/config.py:150
msgid "Follow pre-releases"
msgstr "Seguir pre-lanzamientos"

#: src/common/config.py:151
msgid "Include pre-releases in new release notifications."
msgstr "Incluye pre-lanzamientos en nuevas notificaciones de lanzamiento."

#: src/common/config.py:156
msgid "Theme coverage increased"
msgstr "Cobertura del tema aumentada"

#: src/common/config.py:157
msgid "Notify after a successful refresh when total theme coverage increases. Refreshes with no increase stay quiet."
msgstr "Notificar después de una actualización exitosa cuando aumente la cobertura total del tema. Refresca sin aumentar la tranquilidad."

#: src/common/config.py:164
msgid "Logging"
msgstr "Loggando"

#: src/common/config.py:165
msgid "Logging settings."
msgstr "Configuración de registro."

#: src/common/config.py:169
msgid "Log directory"
msgstr "Directorio de log"

#: src/common/config.py:171
msgid "The directory where to store the log files."
msgstr "El directorio donde guardar los archivos de registro."

#: src/common/config.py:178
msgid "Debug logging"
msgstr "Depurar registro"

#: src/common/config.py:180
msgid "Enable debug logging."
msgstr "Habilitar registro de depuración."

#: src/common/config.py:186
msgid "Network"
msgstr "Red"

#: src/common/config.py:187
msgid "Network settings."
msgstr "Configuración de red."

#: src/common/config.py:191
msgid "HTTP host address"
msgstr "Dirección de host HTTP"

#: src/common/config.py:193
msgid "The HTTP address to bind to."
msgstr "La dirección HTTP a la que enlazar."

#: src/common/config.py:202
msgid "HTTP port"
msgstr "Puerto HTTP"

#: src/common/config.py:204
msgid "Port to bind web server to. Note that ports below 1024 may require root."
msgstr "Puerto al que enlazar el servidor web. Tenga en cuenta que los puertos por debajo de 1024 pueden requerir root."

#: src/common/config.py:212
msgid "HTTP root"
msgstr "Raíz HTTP"

#: src/common/config.py:214
msgid "Todo: The base URL of the web server. Used for reverse proxies."
msgstr "Todo: La URL base del servidor web. Utilizado para proxies inversos."

#: src/common/config.py:219
msgid "MCP allowed hosts"
msgstr "Hosts MCP permitidos"

#: src/common/config.py:220
msgid "Addresses MCP clients may use to connect, for example themerr.example:9494. Separate addresses with commas. Use :* to allow any port."
msgstr "Los clientes MCP de direcciones pueden usar para conectarse, por ejemplo themerr.example:9494. Separar direcciones con comas. Use :* para permitir cualquier puerto."

#: src/common/config.py:227
msgid "Serve MCP over HTTP"
msgstr "Servir MCP sobre HTTP"

#: src/common/config.py:229
msgid "Use the Connector HTTP port configured under Jellyfin for clients that cannot trust Themerr’s self-signed HTTPS certificate. Token authentication is still required. Restart Themerr after changing this setting."
msgstr "Utilice el puerto HTTP del Conector configurado bajo Jellyfin para clientes que no pueden confiar en el certificado HTTPS autofirmado de Themerr. La autenticación de token todavía es requerida. Reinicie Themerr después de cambiar esta configuración."

#: src/common/config.py:235
msgid "SSL"
msgstr "SSL"

#: src/common/config.py:237
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "Ejecutar el servidor web con HTTPS. Deshabilitar esto puede ser un riesgo de seguridad, hacerlo bajo su propio riesgo."

#: src/common/config.py:243
msgid "Updater"
msgstr "Actualización"

#: src/common/config.py:244
msgid "Updater settings."
msgstr "Ajustes del actualizador."

#: src/common/config.py:248
msgid "Auto update"
msgstr "Actualización automática"

#: src/common/config.py:256
msgid "Jellyfin"
msgstr "Jellyfin"

#: src/common/config.py:257
msgid "Jellyfin theme processing settings. Connections are managed on the Servers page."
msgstr "Configuración de procesamiento de temas Jellyfin . Las conexiones se gestionan en la página de servidores."

#: src/common/config.py:260 src/common/config.py:368
msgid "Movie support"
msgstr "Soporte de película"

#: src/common/config.py:261
msgid "Add themes to Jellyfin movies."
msgstr "Añadir temas a las películas de Jellyfin."

#: src/common/config.py:264 src/common/config.py:374
msgid "Series support"
msgstr "Soporte de la serie"

#: src/common/config.py:265
msgid "Add themes to Jellyfin series."
msgstr "Añadir temas a la serie Jellyfin."

#: src/common/config.py:268 src/common/config.py:362 web/templates/home.html:31
msgid "Collections"
msgstr "Colecciones"

#: src/common/config.py:269
msgid "Add themes inside Jellyfin’s collection directories. Media files can remain elsewhere."
msgstr "Añade temas dentro de los directorios de la colección de Jellyfin. Los archivos multimedia pueden permanecer en otro lugar."

#: src/common/config.py:272
msgid "Overwrite user themes"
msgstr "Sobrescribir temas de usuario"

#: src/common/config.py:273
msgid "Replace existing theme files, including themes created by the older Themerr-jellyfin plugin."
msgstr "Reemplace los archivos de temas existentes, incluyendo los temas creados por el complemento de Themerr-jellyfin antiguo."

#: src/common/config.py:277
msgid "Back up replaced user themes"
msgstr "Respaldar temas de usuario reemplazados"

#: src/common/config.py:278
msgid "Keep existing user themes in a backup folder when replacing them. Disable to permanently remove replaced themes."
msgstr "Mantener los temas de usuario existentes en una carpeta de copia de seguridad al reemplazarlos. Desactivar para eliminar permanentemente los temas reemplazados."

#: src/common/config.py:282
msgid "Import older Themerr-jellyfin ownership"
msgstr "Importar posesión de jaletas temáticas antiguas"

#: src/common/config.py:283
msgid "Recognize themes recorded in the older plugin’s database only when their SHA-256 still matches. Changed files stay protected. The old database is left untouched."
msgstr "Reconocer temas grabados en la base de datos del plugin anterior sólo cuando su SHA-256 todavía coincide. Los archivos cambiados permanecen protegidos. La base de datos antigua no se ha tocado."

#: src/common/config.py:287
msgid "Ignore locked metadata"
msgstr "Ignorar metadatos bloqueados"

#: src/common/config.py:288
msgid "Allow Jellyfin theme updates for items with locked metadata."
msgstr "Permitir actualizaciones del tema Jellyfin para elementos con metadatos bloqueados."

#: src/common/config.py:291
msgid "Update connector automatically"
msgstr "Actualizar el conector automáticamente"

#: src/common/config.py:292
msgid "Install the matching connector when Themerr starts or detects a version mismatch. Set the reachable Themerr address on the Servers page first."
msgstr "Instalar el conector coincidente cuando Themerr arranca o detecta un fallo de versión. Establecer la dirección Themerr accesible en la página de servidores primero."

#: src/common/config.py:296
msgid "Restart Jellyfin automatically"
msgstr "Reiniciar Jellyfin automáticamente"

#: src/common/config.py:297
msgid "Restart Jellyfin after installing or updating the connector. A pending restart is shown on the Servers page before it happens."
msgstr "Reinicie Jellyfin después de instalar o actualizar el conector. Se mostrará un reinicio pendiente en la página de servidores antes de que suceda."

#: src/common/config.py:301
msgid "Wait for playback to finish"
msgstr "Espere a que termine la reproducción"

#: src/common/config.py:302
msgid "Defer connector restarts until there are no playing or paused streams."
msgstr "Aplazar el conector se reinicia hasta que no haya flujos en pausa o reproducidos."

#: src/common/config.py:305
msgid "Remove the older Themerr-jellyfin plugin"
msgstr "Eliminar el plugin Themerr-jellyfin anterior"

#: src/common/config.py:306
msgid "After installing the connector, uninstall the older Themerr plugin and remove only its dedicated repository. Existing theme files are kept."
msgstr "Después de instalar el conector, desinstale el antiguo plugin Themerr y elimine sólo su repositorio dedicado. Los archivos de tema existentes están asegurados."

#: src/common/config.py:310
msgid "Connector HTTP port"
msgstr "Puerto HTTP del conector"

#: src/common/config.py:311
msgid "Serve connector downloads and optionally MCP over HTTP. The admin UI stays on HTTPS. Use 0 to disable. Restart Themerr after changing this port."
msgstr "Serva las descargas del conector y opcionalmente MCP sobre HTTP. La interfaz de administración permanece en HTTPS. Use 0 para desactivar. Reinicie Themerr después de cambiar este puerto."

#: src/common/config.py:318
msgid "Plex"
msgstr "Plex"

#: src/common/config.py:319
msgid "Plex settings."
msgstr "Ajustes de Plex."

#: src/common/config.py:323
msgid "Plex URL"
msgstr "URL de Plex"

#: src/common/config.py:324
msgid "The URL to the Plex server."
msgstr "La URL al servidor de Plex."

#: src/common/config.py:333 web/templates/servers.html:98
msgid "Plex data directory"
msgstr "Directorio de datos de Plex"

#: src/common/config.py:334
msgid "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/"
msgstr "https://support.plex.tv/articles/202915258-where-is-the-plex-media-server-data-directory-located/"

#: src/common/config.py:344
msgid "Themerr"
msgstr "Temerario"

#: src/common/config.py:345
msgid "Themerr settings."
msgstr "Ajustes Themerr."

#: src/common/config.py:349
msgid "Scan on startup"
msgstr "Escanear al iniciar"

#: src/common/config.py:350
msgid "Run the theme scan when Themerr starts. Scheduled scans still run when this is disabled. Changes apply the next time Themerr starts."
msgstr "Ejecutar el escaneo de temas cuando Themerr inicie. Escaneo programado todavía se ejecuta cuando esto está deshabilitado. Los cambios aplican la próxima vez que Themerr comience."

#: src/common/config.py:356
msgid "Themerr Enabled"
msgstr "Themerr habilitado"

#: src/common/config.py:357
msgid "When enabled, Themerr will attempt to update themes."
msgstr "Cuando está activado, Themerr intentará actualizar los temas."

#: src/common/config.py:363
msgid "Add themes to collections."
msgstr "Añadir temas a las colecciones."

#: src/common/config.py:369
msgid "Add themes to movies using the Plex Movie agent."
msgstr "Añadir temas a las películas usando el agente Plex Movie ."

#: src/common/config.py:375
msgid "Add themes to series using the Plex Series agent."
msgstr "Añadir temas a la serie usando el agente de la Serie Plex."

#: src/common/config.py:380
msgid "Overwrite Plex themes"
msgstr "Sobrescribir temas de Plex"

#: src/common/config.py:381
msgid "When enabled, Themerr will overwrite themes provided by Plex."
msgstr "Cuando está activado, Themerr sobrescribirá los temas proporcionados por Plex."

#: src/common/config.py:386
msgid "Prefer MP4A AAC Codec"
msgstr "Preferir código MP4A AAC"

#: src/common/config.py:387
msgid "This can improve theme compatibility with Apple devices."
msgstr "Esto puede mejorar la compatibilidad de temas con dispositivos Apple."

#: src/common/config.py:392
msgid "Remove unused themes"
msgstr "Eliminar temas no utilizados"

#: src/common/config.py:393
msgid "Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Libera espacio en el directorio de metadatos de Plex. Esta opción requiere que se establezca la ruta \"Directorio de datos Plex\""

#: src/common/config.py:399
msgid "Remove unused art"
msgstr "Quitar arte no usado"

#: src/common/config.py:400 src/common/config.py:408
msgid "Applies to collection. Frees up space in your Plex metadata directory. This option requires that the \"Plex data directory\" path is set"
msgstr "Se aplica a la colección. Libera espacio en el directorio de metadatos de Plex. Esta opción requiere que se establezca la ruta \"Directorio de datos Plex\""

#: src/common/config.py:407
msgid "Remove unused posters"
msgstr "Quitar posters no utilizados"

#: src/common/config.py:415
msgid "Collection metadata"
msgstr "Metadatos de la colección"

#: src/common/config.py:416
msgid "Update collection metadata (poster, art, and summary) during scheduled update."
msgstr "Actualizar los metadatos de la colección (póster, arte y resumen) durante la actualización programada."

#: src/common/config.py:421
msgid "Ignore locked fields."
msgstr "Ignorar campos bloqueados."

#: src/common/config.py:422
msgid "If you used Themerr v2024.813.13709 or lower, you may need to enable this to update items."
msgstr "Si utilizó Themerr v2024.813.13709 o inferior, puede que necesite habilitar esto para actualizar elementos."

#: src/common/config.py:428
msgid "Ignored library IDs"
msgstr "IDs de biblioteca ignorados"

#: src/common/config.py:429
msgid "Comma-separated library IDs to exclude from scheduled updates. IDs appear on Home."
msgstr "IDs de biblioteca separados por comas para excluir de las actualizaciones programadas. Los IDs aparecen en Inicio."

#: src/common/config.py:435
msgid "Update themes interval"
msgstr "Actualizar intervalo de temas"

#: src/common/config.py:436
msgid "Interval for automatic update task, in minutes (min: 15)."
msgstr "Intervalo para la tarea de actualización automática, en minutos (min: 15)."

#: src/common/config.py:443
msgid "Update database cache interval"
msgstr "Actualizar intervalo de caché de base de datos"

#: src/common/config.py:444
msgid "Interval for database cache update task, in minutes (min: 15)."
msgstr "Intervalo para la tarea de actualización de la caché de base de datos, en minutos (min: 15)."

#: src/common/config.py:451
msgid "PlexAPI timeout"
msgstr "Tiempo de espera de PlexAPI"

#: src/common/config.py:452
msgid "Increase this slightly if you experience timeouts when adding themes. (min: 1)"
msgstr "Aumente esto ligeramente si experimenta tiempos de espera al añadir temas. (min: 1)"

#: src/common/config.py:459
msgid "Theme upload retries"
msgstr "Reintentos de subida del tema"

#: src/common/config.py:460
msgid "If uploading themes fail, retry this many times. (min: 0)"
msgstr "Si la carga de temas falla, vuelva a intentarlo muchas veces. (min: 0)"

#: src/common/config.py:467
msgid "Multiprocessing thread count"
msgstr "Recuento de hilos multiprocesamiento"

#: src/common/config.py:468
msgid "The number of threads to use when adding themes. Restart required. (min: 1)"
msgstr "El número de hilos a usar al añadir temas. Requiere reiniciar. (min: 1)"

#: src/common/config.py:476
msgid "YouTube Cookies"
msgstr "Cookies de YouTube"

#: src/common/config.py:478
msgid "Optional: export youtube.com cookies with Get cookies.txt LOCALLY using its JSON format, then paste the entire JSON array here and save. Saved cookies are encrypted and masked. Select the eye icon to reveal them. Leave this blank to keep them, or select Clear saved cookies to remove them."
msgstr "Opcional: exportar cookies de youtube.com con Get cookies.txt LOCALLY usando su formato JSON, luego pegar toda la matriz JSON aquí y guardar. Las cookies guardadas están cifradas y enmascaradas. Seleccione el icono del ojo para mostrarlas. Deje esto en blanco para mantenerlos, o seleccione Borrar cookies guardadas para eliminarlas."

#: src/common/config.py:485
msgid "Cookie export instructions"
msgstr "Instrucciones de exportación de cookies"

