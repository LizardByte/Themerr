msgid "HTTP root"
msgstr "HTTP 根目录"

#: src/common/config.py:214
msgid "Todo: The base URL of the web server. Used for reverse proxies."
msgstr "待办事项：Web 服务器的基础URL。用于反向代理。"

#: src/common/config.py:219
msgid "MCP allowed hosts"
msgstr "MCP 允许主机"

#: src/common/config.py:220
msgid "Addresses MCP clients may use to connect, for example themerr.example:9494. Separate addresses with commas. Use :* to allow any port."
msgstr "地址 MCP 客户端可以用来连接，例如 themerr.example:9494. 用逗号分隔地址。使用* 允许任何端口。"

#: src/common/config.py:227
msgid "Serve MCP over HTTP"
msgstr "通过 HTTP 服务 MCP"

#: src/common/config.py:229
msgid "Use the Connector HTTP port configured under Jellyfin for clients that cannot trust Themerr’s self-signed HTTPS certificate. Token authentication is still required. Restart Themerr after changing this setting."
msgstr "使用在 Jellyfin 下配置的连接器 HTTP 端口来为无法信任Themerr的自签名HTTPS 证书的客户端。 仍然需要令牌身份验证。更改此设置后重启Themerr。"

#: src/common/config.py:235
msgid "SSL"
msgstr "SSL"

#: src/common/config.py:237
msgid "Run the web server with HTTPS. Disabling this can be a security risk, do so at your own risk."
msgstr "使用 HTTP 运行网络服务器。禁用这可能是一个安全风险，请自行承担风险。"

#: src/common/config.py:243
msgid "Updater"
msgstr "更新器"

#: src/common/config.py:244
msgid "Updater settings."
msgstr "更新程序设置。"

#: src/common/config.py:248
msgid "Auto update"
msgstr "自动更新"

#: src/common/config.py:256
msgid "Jellyfin"
msgstr "Jellyfin"

#: src/common/config.py:257
msgid "Jellyfin theme processing settings. Connections are managed on the Servers page."
msgstr "Jellyfin 主题处理设置。连接管理在服务器页面上。"

#: src/common/config.py:260 src/common/config.py:368
msgid "Movie support"
msgstr "电影支持"

#: src/common/config.py:261
msgid "Add themes to Jellyfin movies."
msgstr "将主题添加到 Jellyfin 电影。"

#: src/common/config.py:264 src/common/config.py:374
msgid "Series support"
msgstr "系列支持"

#: src/common/config.py:265
msgid "Add themes to Jellyfin series."
msgstr "将主题添加到 Jellyfin 系列中。"

#: src/common/config.py:268 src/common/config.py:362 web/templates/home.html:31
msgid "Collections"
msgstr "合集"

#: src/common/config.py:269
msgid "Add themes inside Jellyfin’s collection directories. Media files can remain elsewhere."
msgstr "在 Jellyfin 的收藏目录中添加主题。媒体文件可以留在其他地方。"

#: src/common/config.py:272
msgid "Overwrite user themes"
msgstr "覆盖用户主题"

#: src/common/config.py:273
msgid "Replace existing theme files, including themes created by the older Themerr-jellyfin plugin."
msgstr "替换现有的主题文件，包括由旧的 Themerr-jellyfin 插件创建的主题。"

#: src/common/config.py:277
msgid "Back up replaced user themes"
msgstr "备份被替换的用户主题"

#: src/common/config.py:278
msgid "Keep existing user themes in a backup folder when replacing them. Disable to permanently remove replaced themes."
msgstr "替换现有用户主题时保留在备份文件夹中。禁用以永久删除被替换的主题。"

#: src/common/config.py:282
msgid "Import older Themerr-jellyfin ownership"
msgstr "导入旧的 Themerr-jellyfin 所有权"

#: src/common/config.py:283
msgid "Recognize themes recorded in the older plugin’s database only when their SHA-256 still matches. Changed files stay protected. The old database is left untouched."
msgstr "仅当旧插件数据库中的 SHA-256 仍然匹配时才承认记录的主题。更改的文件仍然受保护。旧的数据库不受触摸。"

#: src/common/config.py:287
msgid "Ignore locked metadata"
msgstr "忽略锁定的元数据"

#: src/common/config.py:288
msgid "Allow Jellyfin theme updates for items with locked metadata."
msgstr "允许 Jellyfin 主题更新带有锁定元数据的项目。"

#: src/common/config.py:291
msgid "Update connector automatically"
msgstr "自动更新连接器"

#: src/common/config.py:292
msgid "Install the matching connector when Themerr starts or detects a version mismatch. Set the reachable Themerr address on the Servers page first."
msgstr "当Themer启动或检测到版本不匹配时安装匹配的连接器。请先在服务器页面设置可访问的Themer地址。"

#: src/common/config.py:296
msgid "Restart Jellyfin automatically"
msgstr "自动重启 Jellyfin"

#: src/common/config.py:297
msgid "Restart Jellyfin after installing or updating the connector. A pending restart is shown on the Servers page before it happens."
msgstr "安装或更新连接器后重启Jellyfin。在服务器页面上显示正在进行的重启。"

#: src/common/config.py:301
msgid "Wait for playback to finish"
msgstr "等待播放完成"

#: src/common/config.py:302
msgid "Defer connector restarts until there are no playing or paused streams."
msgstr "推迟连接器重启直到没有播放或暂停流为止。"

#: src/common/config.py:305
msgid "Remove the older Themerr-jellyfin plugin"
msgstr "删除旧的 Themerr-jellyfin 插件"

#: src/common/config.py:306
msgid "After installing the connector, uninstall the older Themerr plugin and remove only its dedicated repository. Existing theme files are kept."
msgstr "安装连接器后，卸载旧的 Themerr 插件并只移除其专用仓库。现有主题文件将被保存。"

#: src/common/config.py:310
msgid "Connector HTTP port"
msgstr "连接器 HTTP 端口"

#: src/common/config.py:311
msgid "Serve connector downloads and optionally MCP over HTTP. The admin UI stays on HTTPS. Use 0 to disable. Restart Themerr after changing this port."
msgstr "通过 HTTP 提供连接器下载和可选的 MCP 。管理界面位于HTTPS 上。使用 0 可禁用。更改此端口后重新启动Themerr。"

