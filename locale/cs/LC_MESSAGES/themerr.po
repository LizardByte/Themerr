#: src/main.py:171
#, python-format
msgid "%(app_name)s manages theme songs for Plex and Jellyfin.\n"
"Arguments supplied here are meant to be temporary."
msgstr "%(app_name)s spravuje skladby motivů pro Plex a Jellyfin.\n"
"Zde uvedené argumenty jsou určeny jako dočasné."

#: src/main.py:175
msgid "Show this help message and exit"
msgstr "Zobrazit tuto zprávu nápovědy a ukončit"

#: src/main.py:177
msgid "Specify a config file to use"
msgstr "Zadejte konfigurační soubor, který chcete použít"

#: src/main.py:178
msgid "Use debug logging level"
msgstr "Použít úroveň ladění"

#: src/main.py:179
#, python-format
