msgstr "Nutit %(app_name)s běžet na zadaném portu, výchozí =9494"

#: src/main.py:190
msgid "Turn off console logging"
msgstr "Vypnout logování konzole"

#: src/main.py:191
msgid "Print the version details and exit"
msgstr "Vytisknout podrobnosti o verzi a ukončit"

