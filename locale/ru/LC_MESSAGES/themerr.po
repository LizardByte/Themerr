#: src/main.py:171
#, python-format
msgid "%(app_name)s manages theme songs for Plex and Jellyfin.\n"
"Arguments supplied here are meant to be temporary."
msgstr "%(app_name)s отвечает за музыкальное сопровождение приложений Plex и Jellyfin.\n"
"Переданные здесь аргументы носят временный характер."

#: src/main.py:175
msgid "Show this help message and exit"
msgstr "Показать это сообщение справки и выйти"

#: src/main.py:177
msgid "Specify a config file to use"
msgstr "Укажите конфигурационный файл для использования"

#: src/main.py:178
msgid "Use debug logging level"
msgstr "Использовать журнал отладки"

#: src/main.py:179
#, python-format
msgid "Start %(app_name)s in the development environment"
msgstr "Начать %(app_name)s в среде разработки"

#: src/main.py:181
msgid "Health check the container and exit"
msgstr "Проверка состояния контейнера и выход"

#: src/main.py:184
