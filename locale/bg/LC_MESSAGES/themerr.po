#. "%(github)s".
#: src/common/tray_icon.py:116
#, python-format
msgid "%(github)s Releases"
msgstr "%(github)s Новини"

#: src/common/tray_icon.py:119 web/templates/navbar.html:14
msgid "Documentation"
msgstr "Документация"

#: src/common/tray_icon.py:120 web/templates/api_docs.html:6
#: web/templates/api_docs.html:7 web/templates/navbar.html:13
msgid "API documentation"
msgstr "Документация за API"

#. NOTE: Donate to LizardByte.
#: src/common/tray_icon.py:126
msgid "Donate"
msgstr "Дарете"

#: src/common/tray_icon.py:127
msgid "GitHub Sponsors"
msgstr "Спонсори на GitHub"

#. NOTE: Open web browser when application starts. Do not translate
#. "%(app_name)s".
#: src/common/tray_icon.py:136
#, python-format
msgid "Open browser when %(app_name)s starts"
msgstr "Отваряне на браузъра при стартиране на %(app_name)s"

#. NOTE: Disable or turn off icon.
#: src/common/tray_icon.py:139
msgid "Disable icon"
