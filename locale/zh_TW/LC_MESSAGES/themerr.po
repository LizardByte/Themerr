msgstr "強制 %(app_name)s 在指定埠上運行，預設值為 9494"

#: src/main.py:190
msgid "Turn off console logging"
msgstr "關閉主控台記錄"

#: src/main.py:191
msgid "Print the version details and exit"
msgstr "列印版本詳細資訊並退出"

