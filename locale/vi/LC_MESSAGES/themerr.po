msgstr "Themerr hiểu ngôn ngữ của bạn."

#: web/templates/translations.html:3
msgid "Choose a language in Settings, or help improve translations on Crowdin."
msgstr "Chọn ngôn ngữ trong phần Cài đặt, hoặc góp phần cải thiện các bản dịch trên Crowdin."

#: web/templates/translations.html:3
