#: src/main.py:171
#, python-format
msgid "%(app_name)s manages theme songs for Plex and Jellyfin.\n"
"Arguments supplied here are meant to be temporary."
msgstr "%(app_name)s Plex ve Jellyfin için tema şarkılarını yönetir.\n"
"Buraya girilen argümanlar geçici olarak düşünülmüştür."

#: src/main.py:175
msgid "Show this help message and exit"
msgstr "Bu yardım mesajını göster ve çık"

#: src/main.py:177
msgid "Specify a config file to use"
msgstr "Kullanılacak bir yapılandırma dosyası belirtin"

#: src/main.py:178
msgid "Use debug logging level"
msgstr "Hata ayıklama günlüğü düzeyini kullan"

#: src/main.py:179
#, python-format
msgid "Start %(app_name)s in the development environment"
msgstr "Geliştirme ortamında %(app_name)s adresini başlatın"

#: src/main.py:181
msgid "Health check the container and exit"
