msgstr "Wymuś działanie %(app_name)s na określonym porcie, domyślnie=9494"

#: src/main.py:190
msgid "Turn off console logging"
msgstr "Wyłącz rejestrowanie konsoli"

#: src/main.py:191
msgid "Print the version details and exit"
msgstr "Wydrukuj szczegóły wersji i zakończ"

