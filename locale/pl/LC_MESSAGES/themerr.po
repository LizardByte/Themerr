#: src/main.py:171
#, python-format
msgid "%(app_name)s manages theme songs for Plex and Jellyfin.\n"
"Arguments supplied here are meant to be temporary."
msgstr "%(app_name)s zarządza utworami motywu dla Plex i Jellyfin.\n"
"Argumenty dostarczone tutaj mają być tymczasowe."

#: src/main.py:175
msgid "Show this help message and exit"
msgstr "Pokaż tę wiadomość pomocy i wyjdź"

#: src/main.py:177
msgid "Specify a config file to use"
msgstr "Określ plik konfiguracyjny do użycia"

#: src/main.py:178
msgid "Use debug logging level"
msgstr "Użyj poziomu rejestrowania debugowania"

#: src/main.py:179
#, python-format
msgid "Start %(app_name)s in the development environment"
msgstr "Rozpocznij %(app_name)s w środowisku rozwoju"

#: src/main.py:181
msgid "Health check the container and exit"
msgstr "Ocena stanu kontenera i wyjścia"

#: src/main.py:184
#, python-format
