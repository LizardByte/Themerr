msgid "Your session expired. Sign in to continue."
msgstr "Twoja sesja wygasła. Zaloguj się, aby kontynuować."

#: web/js/api.js:25
msgid "Dismiss message"
msgstr "Odrzuć wiadomość"

#: web/js/config.js:7
msgid "Hide cookies"
msgstr "Ukryj ciasteczka"

#: web/js/config.js:7 web/templates/config.html:18
msgid "Show cookies"
msgstr "Pokaż ciasteczka"

