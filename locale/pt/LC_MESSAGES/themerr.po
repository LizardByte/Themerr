msgid "Plex settings."
msgstr "Configurações de Plex."

#: src/common/config.py:323
msgid "Plex URL"
msgstr "URL Plex"

#: src/common/config.py:324
msgid "The URL to the Plex server."
msgstr "A URL para o servidor Plex."

