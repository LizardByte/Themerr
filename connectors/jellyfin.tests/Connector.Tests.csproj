<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../src/jellyfin/compatibility.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ConnectorFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../jellyfin/Themerr.Connector.csproj" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(ConnectorEfCoreVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0" PrivateAssets="all" />
    <PackageReference Include="JunitXml.TestLogger" Version="8.1.0" />
  </ItemGroup>
</Project>
